import("examples/color.pmx")
width = 800;height = 600
screen(1, width, height, white, 1)

buttons_x = 10; buttons_y = 30
button_width = 80; button_height = 20
button(buttons_x, buttons_y, button_width, button_height, 0x3000, 10001, "Button 1")
button(buttons_x, buttons_y + button_height + 10, button_width, button_height, 0x3000, 10002, "Button 2")

while 1:
   bID = peek2(0x5a);poke2(0x5a, 0)
   if bID == 10001:
      poke2(0x1D, 0xFF0000)
      poke2(0x10, 1)
      end
   if bID == 10002:
      poke2(0x1D, 0xFFFFFF)
      poke2(0x10, 1)
      end
end

