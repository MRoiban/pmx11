import("examples/color.pmx")
scale = 2
width = 110*scale;height = 180*scale
screen(1, width, height, white, 1)

rect(15, 40, 190, 20*scale,1, black)

buttons_x = 15; buttons_y = 100
button_width = 20*scale; button_height = 20*scale
button(buttons_x, buttons_y, button_width, button_height, 0x3000, 10010, "CLS");button(buttons_x, buttons_y + button_height + 10, button_width, button_height, 0x3000, 10007, "7");button(buttons_x, buttons_y + 2*button_height + 20, button_width, button_height, 0x3000, 10004, "4");button(buttons_x, buttons_y + 3*button_height + 30, button_width, button_height, 0x3000, 10001, "1")
button(buttons_x, buttons_y + 4*button_height + 40, 3*(button_width)+20, button_height, 0x3000, 10000, "0")

button(buttons_x + button_width + 10, buttons_y, button_width, button_height, 0x3000, 10011, "E")
